{
    "name": "johannesarnold/dokuwiki-plugin-couleur",
    "description": "DokuWiki syntax plugin rendering SVG ribbons/flags of European student fraternities",
    "type": "dokuwiki-plugin",
    "license": "GPL-2.0-only",
    "keywords": ["dokuwiki", "plugin", "svg", "fahne", "couleur"],
    "homepage": "https://www.dokuwiki.org/plugin:fahne",
    "authors": [
        {
            "name": "Johannes Arnold",
            "email": "johannes@arnold.onl"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "classmap": ["syntax.php"]
    },
    "autoload-dev": {
        "files": ["tests/stubs.php"]
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "lint": "php -l syntax.php",
        "test": "phpunit",
        "stan": "phpstan analyse",
        "test:js": "npm test",
        "check": ["@lint", "@test", "@stan", "@test:js"]
    }
}
